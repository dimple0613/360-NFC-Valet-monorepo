{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "360-nfc-valet",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "360-nfc-valet"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "02d09576ae91433692eab7fe1fd42616",
      "localConnectionString": "postgresql://valet:valet_dev@localhost:5432/valet_monorepo?schema=public"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "admin@wewant360.com",
    "SUPER_ADMIN_EMAIL": "admin@wewant360.com",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "587",
    "SMTP_FROM": "360 NFC Valet <360tester05@gmail.com>",
    "SMTP_FROM_NAME": "360 NFC Valet",
    "WS_PORT": "3002",
    "WS_ORIGIN": "https://360-nfc-valet.dimple-49d.workers.dev",
    "WS_BROADCAST_URL": "https://360-nfc-valet.dimple-49d.workers.dev",
    "APP_URL": "https://360-nfc-valet.dimple-49d.workers.dev",
    "CORS_ORIGINS": "https://360-nfc-valet.dimple-49d.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}