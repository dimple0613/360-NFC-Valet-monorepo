# Copy to .env and fill in. Never commit the real .env (see .gitignore).

# --- Database (packages/db) ---
# Local dev: local PostgreSQL. Production: Neon PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/saasclaude?schema=public"

# --- Redis (cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- Auth (web) ---
# Random 32+ byte secret used to sign sessions.
AUTH_SECRET=""
# Base URL of the web app, used for callback/redirect construction.
APP_URL="http://localhost:3000"

# --- Stripe (billing, Phase 1C) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# --- OAuth login (Google + Apple) ---
# Platform-wide only (FR-221's per-org enterprise SSO is a separate, deferred
# feature). Leave unset to hide the corresponding "Continue with ..." button
# entirely - it's not an error state, just an unconfigured provider.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Apple "Sign in with Apple" - a Services ID (client id), your Team ID, the
# Key ID of a Sign in with Apple private key, and that key's PKCS#8 PEM
# content (paste the whole -----BEGIN/END PRIVATE KEY----- block; literal
# \n or real newlines both work).
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# --- Encryption at rest (FR-271 settings, FR-222 MFA secrets/recovery codes) ---
# base64-encoded 32-byte AES-256 key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# --- Platform bootstrap (FR-112/FR-113) ---
# Whoever signs up with this email automatically becomes a Super Admin.
SUPER_ADMIN_EMAIL=""

# --- Scheduled jobs (web/vercel.json crons) ---
# Random secret Vercel sends back as `Authorization: Bearer <CRON_SECRET>` when
# it invokes /api/cron/**; the route rejects any request without a match, so a
# real value here is required for the cron endpoint to be reachable at all.
CRON_SECRET=""
